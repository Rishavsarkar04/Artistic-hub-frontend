# Copy to .env (or .env.local) and fill in per environment. Only VITE_* variables reach the browser,
# so never put secrets here.

# Base URL of the backend API, including the version, without a trailing slash.
# Must match the "servers" URL in Artistic-hub-backend/docs/api/openapi.json.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Request timeout in milliseconds
VITE_API_TIMEOUT=15000
